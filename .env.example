# Server Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=https://peer-buddy-app.vercel.app

# Supabase PostgreSQL Authoritative Database Configuration
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Base URL (for reset links - Host header is not trusted)
FRONTEND_URL=

# SMTP Configuration (for secure password reset and email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@nmims.in

# Supabase Storage Configuration (optional if utilizing Supabase Storage buckets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=peer-buddy-resources

# File Uploads (Local disk fallback)
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=5
