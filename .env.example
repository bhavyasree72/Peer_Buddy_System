PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Configuration
# If DATABASE_URL or DB_USER is provided and reachable, it connects to PostgreSQL.
# Otherwise, it falls back cleanly to the local database file (peer_buddy.db).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peer_buddy
DB_USER=postgres
DB_PASSWORD=postgres

# Security
JWT_SECRET=nmims_peer_buddy_jwt_super_secret_key_2026
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=nmims_peer_buddy_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=5
