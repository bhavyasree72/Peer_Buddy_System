# Server Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=https://peer-buddy-app.vercel.app

# Supabase PostgreSQL Authoritative Database Configuration
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Base URL (for reset links - Host header is not trusted)
FRONTEND_URL=

# Resend Email Configuration (Recommended)
RESEND_API_KEY=
EMAIL_FROM=

# SMTP Configuration (Alternative fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Supabase Project Configuration
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=peer-buddy-resources

# File Uploads (Local disk fallback)
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=5
