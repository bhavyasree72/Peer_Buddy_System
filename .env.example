# Server Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=https://peer-buddy-api.onrender.com
FRONTEND_URL=https://peer-buddy-api.onrender.com

# Firebase Project Configuration
FIREBASE_PROJECT_ID=seproject-feefe
FIREBASE_STORAGE_BUCKET=seproject-feefe.appspot.com

# Firebase Admin SDK Service Account
# Provide either the JSON string or path to JSON credentials file
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Security & Authentication
JWT_SECRET=nmims_peer_buddy_jwt_super_secret_key_2026
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=nmims_peer_buddy_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Resend Email Configuration (Recommended)
RESEND_API_KEY=
EMAIL_FROM=NMIMS Peer Buddy <onboarding@resend.dev>

# SMTP Configuration (Alternative fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# File Uploads (Local disk fallback)
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=5

# Bootstrap Administrator
BOOTSTRAP_ADMIN_EMAIL=type-your-real-@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=type-a-strong-password
BOOTSTRAP_ADMIN_NAME=System Administrator
